{
  "manifest_version": 3,
  "name": "ProfileBar for Chrome",
  "version": "1.2.0",
  "description": "Move tabs and groups to another Chrome profile, and open links in the right profile automatically. Requires ProfileBar for Mac.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "contextMenus",
    "declarativeNetRequest",
    "nativeMessaging",
    "storage",
    "tabGroups",
    "tabs",
    "webNavigation"
  ],
  "action": {},
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "setup.html",
    "open_in_tab": true
  }
}
